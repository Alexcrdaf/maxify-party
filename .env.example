# SyncWave Configuration Variables
# Все переменные являются опциональными и имеют встроенные безопасные значения по умолчанию

# Максимальное количество участников в одной комнате (по умолчанию: 10)
VITE_MAX_PARTICIPANTS=10

# Настройки сервера PeerJS для сигналов WebRTC (по умолчанию используется бесплатное облако peerjs)
# VITE_PEERJS_HOST=peerjs.92ki.biz
# VITE_PEERJS_PORT=443
# VITE_PEERJS_PATH=/
# VITE_PEERJS_SECURE=true
